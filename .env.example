PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/skillverse
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000
ADMIN_SEED_EMAIL=sehisaniyamirsha@gmail.com
ADMIN_SEED_PASSWORD=Admin@12345

# ===== EMAIL (Nodemailer / Gmail) =====
# EMAIL_USER = the Gmail address that SENDS mail
# EMAIL_PASS = a Gmail "App Password" (NOT your normal password)
#              generate one at https://myaccount.google.com/apppasswords
# ADMIN_EMAIL = the email address that RECEIVES admin notifications
#              (new signups, pending certificates/activities)
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_16_char_app_password
EMAIL_FROM_NAME=SkillVerse
ADMIN_EMAIL=sehisaniyamirsha@gmail.com
